<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#0F172A">

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start.io Video Player"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Start.io SDK Status: Active"
        android:textColor="#94A3B8"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="#334155" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Video Gallery (Monetized with Start.io)"
        android:textColor="#E2E8F0"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Free Video Item -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#1E293B"
        app:cardCornerRadius="12dp"
        app:strokeColor="#334155">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4K Wildlife Documentary (Free)"
                android:textColor="#38BDF8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnOpenVideo1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Watch Stream" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Locked Video Item 1 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#1E293B"
        app:cardCornerRadius="12dp"
        app:strokeColor="#6366F1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒 Cyberpunk Metropolis 2099 (Locked)"
                android:textColor="#818CF8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Requires watching Start.io Rewarded Video to unlock"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnOpenVideo2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#4F46E5"
                android:text="Unlock &amp; Watch Video" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Locked Video Item 2 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#1E293B"
        app:cardCornerRadius="12dp"
        app:strokeColor="#334155">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒 Extreme Downhill Biking (Locked)"
                android:textColor="#F43F5E"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnOpenVideo3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#E11D48"
                android:text="Unlock &amp; Watch Video" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
